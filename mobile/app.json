{
  "expo": {
    "name": "yugen",
    "slug": "yugen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#100f0e",
    "android": {
      "package": "dev.gal1ce.yugen",
      "adaptiveIcon": {
        "backgroundColor": "#100f0e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "extraProguardRules": "# youtubedl-android unpacks python through commons-compress, which registers its zip\n# fields by reflection, and reads yt-dlp's release json through jackson\n-keep class com.yausername.** { *; }\n-keep class org.apache.commons.** { *; }\n-keep class com.fasterxml.jackson.** { *; }\n-dontwarn org.apache.commons.**\n-dontwarn com.fasterxml.jackson.**"
          }
        }
      ],
      "./plugins/with-ui-assets",
      "expo-asset"
    ]
  }
}
